# Google Cloud OAuth 2.0 Web application credentials
# Enable Google Drive API and add this exact redirect URI to Authorized redirect URIs.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3001/api/drive/oauth/callback
MATJARK_APP_ORIGIN=https://localhost:3000

# Generate a 32-byte key and write its 64-character hexadecimal value here.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# The refresh token is encrypted here. Keep this folder private and backed up separately.
MATJARK_DATA_DIR=.matjark-data
API_PORT=3001
